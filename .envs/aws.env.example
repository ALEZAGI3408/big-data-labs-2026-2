# AWS Credentials — copia este archivo como aws.env y completa los valores
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# Nombre base para los recursos del curso (no uses espacios ni mayúsculas)
PROJECT_NAME=paytrack-bigdata
STUDENT_ID=tu_apellido  # cambia por tu apellido, ej: garcia
